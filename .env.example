# Koneksi database (pooled) — dipakai aplikasi saat runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Koneksi langsung (non-pooled) — dipakai Prisma migrate. Untuk Neon isi connection string "direct".
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Secret untuk Auth.js — generate dengan: npx auth secret
AUTH_SECRET="ganti-dengan-hasil-npx-auth-secret"
